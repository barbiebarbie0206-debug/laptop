# ============================================
# Laptop Allocation Management System - .env.example
# ============================================

# --- Backend Configuration ---
# SQLite (default for local development - no setup required)
DATABASE_URL=sqlite:///./laptop_allocation.db

# PostgreSQL (production / shared environments)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/laptop_allocation

# --- Application ---
PROJECT_NAME=Laptop Allocation Management System
VERSION=1.0.0

# --- Security / JWT ---
# Use a strong random secret key in production
SECRET_KEY=change-me-in-production-9f8f0e2a4b6c8d0e1f2a3b4c
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
# Vite dev server port
VITE_DEV_PORT=5173
# Backend API base URL used by the frontend proxy
VITE_API_BASE_URL=http://localhost:8000/api/v1
