# Frontend environment (copy to frontend/.env only if you MUST customize)
#
# RECOMMENDED (dev): leave VITE_API_BASE_URL unset. Frontend requests go to the
# same origin (http://localhost:5173/api/v1) and the Vite dev proxy forwards
# them to the backend at http://127.0.0.1:8000. No CORS involved - the most
# reliable setup.
#
# OPTIONAL (alternative): set the full backend URL. Only use this if you are
# NOT running through the Vite proxy (e.g. a custom host/port layout). The
# backend CORS list must then include your frontend origin.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1