# ============================================
# Laptop Allocation Management System - Backend .env.example
# Copy to .env and adjust as needed.
# NEVER commit your real .env file. Keep secrets out of the repository.
# ============================================

# --- Database Configuration ---
# SQLite (default for local development - no setup required)
DATABASE_URL=sqlite:///./laptop_allocation.db

# PostgreSQL (production / shared environments)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/laptop_allocation

# MySQL 8 (requires PyMySQL, included in requirements.txt)
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
# Create the schema + seed dataset before first run:
#   python scripts/load_mysql_dataset.py
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/laptop_allocation

# --- Application ---
PROJECT_NAME=Laptop Allocation Management System
VERSION=1.0.0

# --- Security / JWT ---
# Use a strong random secret key in production, e.g. generated via:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# WARNING: the default value below is NOT secure and must be changed.
SECRET_KEY=change-me-in-production-9f8f0e2a4b6c8d0e1f2a3b4c
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Default admin credentials (seeded on first run) ---
# Username: admin
# Password: admin123
# IMPORTANT: change this password after the first login.